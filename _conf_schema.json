{
  "nycnm": {
    "description": "柠柚 API（梗图猜词、历史上的今天共用）",
    "type": "object",
    "items": {
      "api_key": {
        "description": "柠柚 API Key",
        "type": "string",
        "default": "",
        "secret": true,
        "hint": "在 https://api.nycnm.cn 注册后于用户中心获取"
      },
      "timeout": {
        "description": "请求超时（秒）",
        "type": "int",
        "default": 10
      }
    }
  },
  "left_brain": {
    "description": "左右脑互搏",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/左右脑互搏 [回合数]`，需要已配置对话模型"
      },
      "max_rounds": {
        "description": "最大回合数",
        "type": "int",
        "default": 10,
        "hint": "不写回合数时默认 3 回合"
      }
    }
  },
  "look_leg": {
    "description": "看看腿",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": false,
        "hint": "`/看看腿` 发送随机图片"
      },
      "api": {
        "description": "图片接口",
        "type": "string",
        "default": "https://api.nycnm.cn/api/v2/meitui1",
        "hint": "直接返回图片，或返回含图片链接的 JSON 均可"
      }
    }
  },
  "history_today": {
    "description": "历史上的今天",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/历史上的今天`"
      },
      "format": {
        "description": "发送形式",
        "type": "string",
        "options": [
          "image",
          "text"
        ],
        "labels": [
          "图片",
          "文字"
        ],
        "default": "image",
        "hint": "使用柠柚接口；未填柠柚 API Key 时改用免费文字接口"
      }
    }
  },
  "emoji_mix": {
    "description": "Emoji 合成",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/合成😀😭`，可不加空格"
      }
    }
  },
  "dot_matrix": {
    "description": "点阵字",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/点阵字 内容 填充字`"
      }
    }
  },
  "jrrp": {
    "description": "今日人品",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/今日人品`"
      }
    }
  },
  "sensoji": {
    "description": "浅草寺抽签",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/抽签`、`/转运`、`/解签` 和 explain_fortune 函数工具"
      },
      "enable_change_fortune": {
        "description": "是否启用转运功能",
        "type": "bool",
        "default": true,
        "hint": "关闭后用户将无法使用转运功能"
      },
      "max_change_fortune_times": {
        "description": "每日最大转运次数（0 表示不限制）",
        "type": "int",
        "default": 3
      },
      "daily_cleanup": {
        "description": "签文图片保留天数",
        "type": "int",
        "default": 1,
        "hint": "超过该天数的签文图片会被自动删除，0 表示不清理"
      }
    }
  },
  "runes": {
    "description": "卢恩占卜",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/卢恩占卜`，解读需要已配置对话模型"
      },
      "interpretation_depth": {
        "description": "解释深度",
        "type": "string",
        "options": [
          "简洁",
          "详细",
          "深度"
        ],
        "default": "详细"
      },
      "include_history": {
        "description": "包含历史解读",
        "type": "bool",
        "default": true,
        "hint": "是否在解读中包含符文的历史背景"
      }
    }
  },
  "gengtu": {
    "description": "梗图猜词",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/梗图`、`/答案`，需要柠柚 API Key"
      },
      "api_url": {
        "description": "梗图接口地址",
        "type": "string",
        "default": "https://api.nycnm.cn/api/v2/gengtu"
      }
    }
  },
  "safebooru": {
    "description": "随机图片（Safebooru）",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/随机图片 [标签]`"
      },
      "limit": {
        "description": "API 返回图片的数量上限",
        "type": "int",
        "default": 100,
        "hint": "同一标签会依次轮换这些图片，建议 100 以内"
      },
      "display_tags": {
        "description": "发送图片前显示 tags",
        "type": "bool",
        "default": false
      }
    }
  },
  "tagger": {
    "description": "图片标签识别",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/tag`"
      },
      "api_url": {
        "description": "Gradio 接口地址",
        "type": "string",
        "default": "https://smilingwolf-wd-tagger.hf.space/gradio_api",
        "hint": "WD Tagger 类 Gradio 应用的 API 根地址（以 /gradio_api 结尾），可换成自建的同款 Space"
      },
      "model": {
        "description": "识别模型",
        "type": "string",
        "default": "SmilingWolf/wd-swinv2-tagger-v3",
        "hint": "填写该 Space 支持的模型名"
      },
      "general_threshold": {
        "description": "普通标签阈值",
        "type": "float",
        "default": 0.35
      },
      "character_threshold": {
        "description": "角色标签阈值",
        "type": "float",
        "default": 0.85
      },
      "wait_seconds": {
        "description": "等待图片时长（秒）",
        "type": "int",
        "default": 60,
        "hint": "/tag 没带图片时，在这段时间内等待同一用户发图"
      }
    }
  },
  "qrcode": {
    "description": "二维码",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/二维码`：带内容生成，带图识别"
      },
      "wait_seconds": {
        "description": "等待图片时长（秒）",
        "type": "int",
        "default": 60,
        "hint": "/二维码 不带内容和图片时，在这段时间内等待同一用户发图"
      }
    }
  },
  "weather": {
    "description": "天气",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/天气 [城市]` 和 get_weather 函数工具，需要心知天气 API 私钥"
      },
      "seniverse_api_key": {
        "description": "心知天气 API 私钥",
        "type": "string",
        "default": "",
        "secret": true,
        "hint": "在 https://www.seniverse.com 注册，控制台 → 产品管理 → 免费版 → 复制「私钥」"
      },
      "default_city": {
        "description": "默认城市",
        "type": "string",
        "default": "上海",
        "hint": "用户没有输入城市时使用"
      },
      "send_mode": {
        "description": "发送模式",
        "type": "string",
        "options": [
          "text",
          "image"
        ],
        "labels": [
          "文字",
          "图片"
        ],
        "default": "text"
      }
    }
  },
  "translation": {
    "description": "百度翻译",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/翻译 <语种> <内容>`"
      },
      "appid": {
        "description": "APP ID",
        "type": "string",
        "default": "",
        "hint": "在 https://fanyi-api.baidu.com 开通通用文本翻译后，在「管理控制台 → 开发者信息」查看"
      },
      "secret_key": {
        "description": "密钥",
        "type": "string",
        "default": "",
        "secret": true,
        "hint": "与 APP ID 在同一页面"
      }
    }
  },
  "ipquery": {
    "description": "IP / 域名查询",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/查IP`、`/查域名`"
      }
    }
  },
  "aicu": {
    "description": "B 站查询（AICU）",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/B站查询 <UID>`"
      },
      "cookie": {
        "description": "AICU 网站 Cookie",
        "type": "string",
        "default": "",
        "secret": true,
        "hint": "可选，需包含 ASession=...；浏览器登录 aicu.cc 后按 F12 在网络请求中复制。不填时设备信息不可用"
      }
    }
  },
  "math_plotter": {
    "description": "数学绘图",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "plot_2d、plot_3d、plot_vectors 函数工具"
      },
      "plot_dpi": {
        "description": "图像分辨率 (DPI)",
        "type": "int",
        "default": 120,
        "hint": "建议 100-200，越高越清晰、文件越大"
      },
      "default_x_range": {
        "description": "默认 x 轴范围",
        "type": "string",
        "default": "-10,10",
        "hint": "格式：最小值,最大值"
      },
      "line_width": {
        "description": "曲线线宽",
        "type": "float",
        "default": 2.0
      },
      "grid_alpha": {
        "description": "网格透明度",
        "type": "float",
        "default": 0.3,
        "hint": "0 为完全透明，1 为完全不透明"
      },
      "plot_3d_grid_density": {
        "description": "3D 曲面网格密度",
        "type": "int",
        "default": 200,
        "hint": "每个轴上的采样点数，建议 100-400"
      },
      "plot_3d_cmap": {
        "description": "3D 曲面配色方案",
        "type": "string",
        "default": "viridis",
        "hint": "matplotlib colormap 名称，如 viridis、plasma、coolwarm"
      },
      "plot_3d_alpha": {
        "description": "3D 曲面透明度",
        "type": "float",
        "default": 0.88
      },
      "plot_3d_contour_offset": {
        "description": "在底面投影等值线",
        "type": "bool",
        "default": true
      },
      "plot_3d_elev": {
        "description": "3D 视图仰角（度）",
        "type": "int",
        "default": 25
      },
      "plot_3d_azim": {
        "description": "3D 视图方位角（度）",
        "type": "int",
        "default": -60
      }
    }
  },
  "calculate": {
    "description": "精确计算",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "calculate 函数工具，让 LLM 精确计算算式"
      }
    }
  },
  "markdown2img": {
    "description": "Markdown 转图片",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "提示 LLM 把复杂格式写进 <md></md>，发送时渲染成图片"
      }
    }
  },
  "zanwo": {
    "description": "点赞",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`赞我`、`赞@某人`、`/订阅点赞`（再发一次取消），仅 QQ（aiocqhttp）"
      },
      "white_list_groups": {
        "description": "群聊白名单",
        "type": "list",
        "default": [],
        "hint": "填写后只有这些群能用点赞；留空则所有群可用"
      },
      "subscribed_users": {
        "description": "订阅点赞的用户",
        "type": "list",
        "default": [],
        "hint": "每天首次有人点赞时，自动给这些 QQ 号点赞；用户可用 /订阅点赞 自行加入"
      },
      "zanwo_date": {
        "description": "上次自动点赞日期",
        "type": "string",
        "default": "2025-01-01",
        "invisible": true
      }
    }
  },
  "rewind": {
    "description": "对话回退",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "`/回退 [轮数]`（`/rewind x`）删掉最近几轮对话，默认 1 轮、最多 10 轮；下一次对话前可用 `/取消回退`（`/rewind cancel`）恢复"
      }
    }
  }
}
